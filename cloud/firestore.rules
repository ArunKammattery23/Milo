rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function own(uid) { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true && !exists(/databases/$(database)/documents/deletedUsers/$(uid)); }
    match /users/{uid} { allow get: if own(uid); allow list, write: if false;
      match /contacts/{peer} { allow read: if own(uid); allow write: if false; }
      match /messages/{message} { allow read: if own(uid); allow write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
