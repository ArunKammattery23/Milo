rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function own(uid) { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true && !exists(/databases/$(database)/documents/deletedUsers/$(uid)); }
    match /users/{uid} { allow get: if own(uid); allow list, write: if false;
      match /contacts/{peer} { allow read: if own(uid); allow write: if false; }
      match /messages/{message} { allow read: if own(uid); allow write: if false; }
    }
    // Spark: authenticated clients use atomic writes; no privileged key is in the app.
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function alive(uid) { return get(/databases/$(database)/documents/sparkUsers/$(uid)).data.active == true; }
    function me() { return verified() && alive(request.auth.uid); }
    function shortName(value) { return value is string && value.size() > 0 && value.size() <= 40; }
    function clear(a, b) {
      return (!exists(/databases/$(database)/documents/sparkUsers/$(a)/blocks/$(b)) || get(/databases/$(database)/documents/sparkUsers/$(a)/blocks/$(b)).data.blocked == false)
          && (!exists(/databases/$(database)/documents/sparkUsers/$(b)/blocks/$(a)) || get(/databases/$(database)/documents/sparkUsers/$(b)/blocks/$(a)).data.blocked == false);
    }
    function afterBlocks(a,b,created) {
      return (!exists(/databases/$(database)/documents/sparkUsers/$(a)/blocks/$(b)) || get(/databases/$(database)/documents/sparkUsers/$(a)/blocks/$(b)).data.createdAt < created)
          && (!exists(/databases/$(database)/documents/sparkUsers/$(b)/blocks/$(a)) || get(/databases/$(database)/documents/sparkUsers/$(b)/blocks/$(a)).data.createdAt < created);
    }
    function budget(id) {
      let path = /databases/$(database)/documents/sparkUsers/$(request.auth.uid)/limits/actions;
      return getAfter(path).data.lastId == id && getAfter(path).data.lastAt == request.time
          && (!exists(path) || get(path).data.lastId != id);
    }
    match /sparkUsers/{uid} {
      allow get: if verified() && request.auth.uid == uid;
      allow create: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','active'])
        && shortName(request.resource.data.name)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true;
      allow update: if verified() && request.auth.uid == uid && (request.resource.data == resource.data || (resource.data.active == true
        && request.resource.data.keys().hasOnly(['name','email','active'])
        && ((request.resource.data.active == true && shortName(request.resource.data.name)
          && request.resource.data.email == request.auth.token.email)
          || (request.resource.data.active == false && request.resource.data.name == 'Deleted account' && request.resource.data.email == ''))));
      match /blocks/{peer} {
        allow read: if verified() && request.auth.uid == uid;
        allow create: if me() && request.auth.uid == uid && peer != uid
          && request.resource.data.keys().hasOnly(['createdAt','blocked']) && request.resource.data.createdAt == request.time && request.resource.data.blocked == true;
        allow update: if me() && request.auth.uid == uid && peer != uid
          && request.resource.data.keys().hasOnly(['createdAt','blocked'])
          && ((request.resource.data.blocked == true && request.resource.data.createdAt == request.time)
            || (request.resource.data.blocked == false && request.resource.data.createdAt == resource.data.createdAt));
      }
      match /limits/actions {
        allow get: if me() && request.auth.uid == uid;
        allow create, update: if me() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['start','count','lastId','lastAt'])
          && request.resource.data.lastAt == request.time
          && request.resource.data.lastId is string && request.resource.data.lastId.size() <= 180
          && request.resource.data.count is int && request.resource.data.count <= 120
          && ((!exists(/databases/$(database)/documents/sparkUsers/$(uid)/limits/actions)
                && request.resource.data.start == request.time && request.resource.data.count == 1)
            || (resource.data.start + duration.value(24, 'h') <= request.time
                && request.resource.data.start == request.time && request.resource.data.count == 1)
            || (request.resource.data.start == resource.data.start
                && request.resource.data.count == resource.data.count + 1));
      }
    }
    match /sparkInvites/{code} {
      allow get: if me() && (resource.data.fromUid == request.auth.uid || resource.data.toEmail == request.auth.token.email);
      allow list: if me() && resource.data.fromUid == request.auth.uid;
      allow create: if me() && code.matches('[a-f0-9]{32}')
        && request.resource.data.keys().hasOnly(['fromUid','fromName','fromEmail','toEmail','alias','createdAt','expiresAt','acceptedBy'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromName == get(/databases/$(database)/documents/sparkUsers/$(request.auth.uid)).data.name
        && request.resource.data.fromEmail == request.auth.token.email
        && request.resource.data.toEmail is string && request.resource.data.toEmail.size() <= 254
        && request.resource.data.toEmail.matches('.+@.+[.].+') && request.resource.data.toEmail != request.auth.token.email
        && shortName(request.resource.data.alias) && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(24,'h')
        && request.resource.data.acceptedBy == '' && budget('invite/' + code);
      allow update: if me() && resource.data.toEmail == request.auth.token.email
        && resource.data.fromUid != request.auth.uid && alive(resource.data.fromUid)
        && resource.data.acceptedBy == '' && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedBy'])
        && request.resource.data.acceptedBy == request.auth.uid && clear(resource.data.fromUid, request.auth.uid)
        && getAfter(/databases/$(database)/documents/sparkRooms/$(code)).data.toUid == request.auth.uid;
      allow delete: if verified() && request.auth.uid == resource.data.fromUid;
    }
    match /sparkRooms/{room} {
      function member() { return me() && request.auth.uid in resource.data.members; }
      function invite() { return get(/databases/$(database)/documents/sparkInvites/$(room)).data; }
      allow read: if member();
      allow create: if me() && request.resource.data.keys().hasOnly(['members','fromUid','toUid','fromName','toName','fromEmail','toEmail','fromAlias','toAlias','active','createdAt'])
        && invite().acceptedBy == '' && invite().expiresAt > request.time
        && invite().toEmail == request.auth.token.email && invite().fromUid != request.auth.uid
        && alive(invite().fromUid) && clear(invite().fromUid, request.auth.uid)
        && getAfter(/databases/$(database)/documents/sparkInvites/$(room)).data.acceptedBy == request.auth.uid
        && request.resource.data.members == [invite().fromUid, request.auth.uid]
        && request.resource.data.fromUid == invite().fromUid && request.resource.data.toUid == request.auth.uid
        && request.resource.data.fromName == invite().fromName && request.resource.data.fromEmail == invite().fromEmail
        && request.resource.data.toName == get(/databases/$(database)/documents/sparkUsers/$(request.auth.uid)).data.name
        && request.resource.data.toEmail == request.auth.token.email
        && request.resource.data.fromAlias == invite().alias && shortName(request.resource.data.toAlias)
        && request.resource.data.active == true && request.resource.data.createdAt == request.time;
      allow update: if member() && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']) && request.resource.data.active == false;
      match /messages/{id} {
        function channel() { return get(/databases/$(database)/documents/sparkRooms/$(room)).data; }
        function participant() { return me() && request.auth.uid in channel().members; }
        allow read: if participant();
        allow create: if participant() && channel().active == true && alive(channel().fromUid) && alive(channel().toUid)
          && clear(channel().fromUid, channel().toUid) && afterBlocks(channel().fromUid, channel().toUid,channel().createdAt) && id.matches('[a-f0-9-]{36}')
          && request.resource.data.keys().hasOnly(['fromUid','text','createdAt','readAt','hiddenBy'])
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time && request.resource.data.readAt == null
          && request.resource.data.hiddenBy == [] && budget(room + '/' + id);
        allow update: if participant() && (
          (resource.data.fromUid != request.auth.uid && resource.data.readAt == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) && request.resource.data.readAt == request.time)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenBy'])
            && !(request.auth.uid in resource.data.hiddenBy)
            && request.resource.data.hiddenBy == resource.data.hiddenBy.concat([request.auth.uid])));
        allow delete: if verified() && request.auth.uid == resource.data.fromUid
          && request.auth.uid in channel().members;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
